#
# Redmi AX6000 (MT7986A / MTK U-Boot layout) — 激进最终版
# 上游: chasey-dev/immortalwrt-mt798x-rebase 的 25.12 分支（默认跟最新 HEAD）
# 基线: defconfig/mt7986-ax6000.config
#
# 【不做保守回退：3d34af8/3892b02 的编译侧改动全部保留】
#   - 每次 run 解析 25.12 最新 HEAD；需要复现/回退时用 workflow_dispatch 的
#     upstream_ref=pinned（用 config/upstream.lock）或直接填 40 位 SHA。
#   - feeds 锁到 2026-11-13 各 feed 的 openwrt-25.12 HEAD（config/feeds.lock）。
#   - CONFIG_PKG_CHECK_FORMAT_SECURITY=y、CONFIG_PKG_RELRO_FULL=y、CONFIG_CCACHE=y。
#   - 显式 CONFIG_PACKAGE_kmod-nft-fullcone=y。跟最新上游时有这个包；用 pinned
#     回退到 9f397975 时它不存在，defconfig 会丢弃并在差异检查里给 warning，
#     所以 required-packages.txt 不硬断言它，避免回退模式直接红。
#
# **保留的改进（编译侧）**：
#   - 包精简（ATA/SCSI/VFAT/NLS、ebtables、tcpdump/htop/nano/libfido2 等）
#   - 移除 WOL（luci-app-wol / luci-i18n-wol-zh-cn / etherwake）
#   - hnat-detect / mtk-smp（MT7986 HNAT 检测与 SMP 调优）
#   - 关闭厂商调试/诊断项：WARP_DBG、WARP_MEMORY_LEAK_DBG、ATE、AIR_MONITOR、
#     ICAP、SPECTRUM；以及内核 DEBUG_INFO / DEBUG_MISC / LOCK_DEBUGGING / PCI_DEBUG
#   - CONFIG_PKG_FORTIFY_SOURCE_2=y；删除上游已不存在的 TURBOACC_INCLUDE_* 残留
#
# **保留的运行时改进（不参与编译，全部编入固件）**：
#   files/ 下 4 个脚本 —— 首启无口令保护（ttyd+dropbear+WiFi）、幂等默认值、
#   显式 flow_offloading=0 / fullcone=1、WAN REJECT（family=any）、LED、
#   /etc/sysctl.conf 四键（conntrack/backlog/ESTABLISHED/swappiness）、
#   CPU governor 档位（默认 schedutil，可手动切 performance）、/etc/ax6000-build-info。
#
# 【失败不用改代码】workflow_dispatch 的 hardening=off 会临时关掉
#   CHECK_FORMAT_SECURITY / RELRO_FULL / CCACHE 做 A/B；编译失败会自动打印
#   错误摘要并跑 make -j1 V=s。
#
# 改动（相对上游 defconfig）:
#   1. 只编 xiaomi_redmi-router-ax6000-mtkuboot 一个设备
#   2. 去掉 smartdns / 网速控制(eqos-mtk) / mtkhqos_util / UPnP / WOL
#   3. 保留 MTK 闭源 WiFi 驱动、HNAT、TurboACC，TCP CC 走 cubic
#   4. 新增 Auto Reboot / TTYD 及其中文语言包
#   5. 精简 AX6000 上没有对应硬件的包（kmod-fs-autofs4 因 blockd 依赖保留）
#

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-mtkuboot=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-mtkuboot=""

CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_AFALG_UPDATE_CTR_IV=y
CONFIG_BUSYBOX_CONFIG_BLKID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y
# CONFIG_GDB is not set
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
# 生产固件不需要内核调试信息/锁调试/PCI 调试：减小 build_dir 与镜像、缩短编译时间
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_MISC is not set
# CONFIG_KERNEL_LOCK_DEBUGGING_SUPPORT is not set
# CONFIG_KERNEL_PCI_DEBUG is not set
# 不要用 CONFIG_KERNEL_IP_NF_IPTABLES=m 去补：OpenWrt 的 CONFIG_KERNEL_* 在
# make defconfig 时按 bool 归一化，=m 会被直接丢掉（run #11 已实测）。
# 正确做法是禁掉 kmod-nft-compat，见上面 KMODS 段。
# CONFIG_KERNEL_BLK_DEV_THROTTLING is not set
# CONFIG_KERNEL_CFS_BANDWIDTH is not set
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_DEVMEM=y
# CONFIG_KERNEL_KEYS is not set
# CONFIG_KERNEL_MEMCG_SWAP is not set
CONFIG_KERNEL_NET_CLS_CGROUP=y

#######################################################################
#                              KMODS                                  #
#######################################################################

# CONFIG_PACKAGE_kmod-ata-core is not set
# CONFIG_PACKAGE_kmod-ebtables is not set
# CONFIG_PACKAGE_kmod-ebtables-ipv4 is not set
# CONFIG_PACKAGE_kmod-ebtables-ipv6 is not set
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-ccm=y
CONFIG_PACKAGE_kmod-crypto-cmac=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-crypto-ctr=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-gf128=y
CONFIG_PACKAGE_kmod-crypto-ghash=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-md4=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-fs-autofs4=y
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-ifb is not set
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-leds-ws2812b=y
CONFIG_PACKAGE_kmod-lib-crc32c=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-nf-flow=y
# kmod-nft-compat 的 DEPENDS 里有 +kmod-nf-ipt，而 kmod-nf-ipt 要求 ip_tables.ko；
# 上游 target/linux/generic/config-6.12 把 CONFIG_IP_NF_IPTABLES 与
# CONFIG_NETFILTER_XTABLES 都关掉了，两个 .ko 根本不编，打包时直接
#   ERROR: module '.../net/ipv4/netfilter/ip_tables.ko' is missing.
# （Actions run #10 实际报错）
# firewall4 / nftables 的 Makefile 都不依赖 nft-compat（只依赖 kmod-nft-fullcone 等），
# fw4 生成的是 native nft 表达式，不需要 xtables 兼容层。因此直接禁掉，
# 比硬塞 CONFIG_KERNEL_* 更干净（后者在 defconfig 会被 bool 归一化掉）。
# CONFIG_PACKAGE_kmod-nft-compat is not set
# CONFIG_PACKAGE_kmod-nf-ipt is not set
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
# CONFIG_PACKAGE_kmod-nls-base is not set
# CONFIG_PACKAGE_kmod-nls-cp437 is not set
# CONFIG_PACKAGE_kmod-nls-iso8859-1 is not set
# CONFIG_PACKAGE_kmod-nls-utf8 is not set
CONFIG_PACKAGE_kmod-sched-core=y
# CONFIG_PACKAGE_kmod-scsi-core is not set
# luci-app-turboacc-mtk 会 select kmod-tcp-bbr；保留模块，但不装 BBR sysctl，保持 cubic
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_kmod-zram=y

#######################################################################
#                          WIFI OPTIONS                               #
#######################################################################

CONFIG_CONNINFRA_AUTO_UP=y
CONFIG_CONNINFRA_EMI_SUPPORT=y
CONFIG_MTK_ACK_CTS_TIMEOUT_SUPPORT=y
# 关掉厂商诊断/产测功能：AIR_MONITOR、ATE 属于抓包与产线测试，家用不需要
# CONFIG_MTK_AIR_MONITOR is not set
CONFIG_MTK_AMPDU_CONF_SUPPORT=y
CONFIG_MTK_ANTENNA_CONTROL_SUPPORT=y
CONFIG_MTK_APCLI_SUPPORT=y
# CONFIG_MTK_ATE_SUPPORT is not set
CONFIG_MTK_BACKGROUND_SCAN_SUPPORT=y
CONFIG_MTK_CAL_BIN_FILE_SUPPORT=y
CONFIG_MTK_CFG_SUPPORT_FALCON_MURU=y
CONFIG_MTK_CFG_SUPPORT_FALCON_PP=y
CONFIG_MTK_CFG_SUPPORT_FALCON_SR=y
CONFIG_MTK_CFG_SUPPORT_FALCON_TXCMD_DBG=y
CONFIG_MTK_CHIP_MT7986=y
CONFIG_MTK_CONNINFRA_APSOC=y
CONFIG_MTK_CONNINFRA_APSOC_MT7986=y
CONFIG_MTK_CON_WPS_SUPPORT=y
CONFIG_MTK_DBDC_MODE=y
CONFIG_MTK_DOT11K_RRM_SUPPORT=y
CONFIG_MTK_DOT11R_FT_SUPPORT=y
CONFIG_MTK_DOT11W_PMF_SUPPORT=y
CONFIG_MTK_DOT11_HE_AX=y
CONFIG_MTK_DOT11_N_SUPPORT=y
CONFIG_MTK_DOT11_VHT_AC=y
CONFIG_MTK_FAST_NAT_SUPPORT=y
CONFIG_MTK_FIRST_IF_EEPROM_FLASH=y
CONFIG_MTK_FIRST_IF_IPAILNA=y
CONFIG_MTK_FIRST_IF_MT7986=y
CONFIG_MTK_GREENAP_SUPPORT=y
CONFIG_MTK_G_BAND_256QAM_SUPPORT=y
CONFIG_MTK_HDR_TRANS_RX_SUPPORT=y
CONFIG_MTK_HDR_TRANS_TX_SUPPORT=y
# ICAP 是抓包/诊断内核模块，家用固件关闭
# CONFIG_MTK_ICAP_SUPPORT is not set
CONFIG_MTK_IGMP_SNOOP_SUPPORT=y
CONFIG_MTK_INTERWORKING=y
CONFIG_MTK_MAP_R2_VER_SUPPORT=y
CONFIG_MTK_MAP_R3_VER_SUPPORT=y
CONFIG_MTK_MAP_SUPPORT=y
CONFIG_MTK_MBSS_DTIM_SUPPORT=y
CONFIG_MTK_MBSS_SUPPORT=y
CONFIG_MTK_MCAST_RATE_SPECIFIC=y
CONFIG_MTK_MGMT_TXPWR_CTRL=y
CONFIG_MTK_MLME_MULTI_QUEUE_SUPPORT=y
CONFIG_MTK_MT_AP_SUPPORT=m
CONFIG_MTK_MT_DFS_SUPPORT=y
CONFIG_MTK_MT_MAC=y
CONFIG_MTK_MT_WIFI=m
CONFIG_MTK_MT_WIFI_DRIVER_VERSION_7673=y
CONFIG_MTK_MT_WIFI_FIRMWARE_PATH_MT7986="mt7986-fw-20260601"
CONFIG_MTK_MT_WIFI_MT7986_20260601=y
CONFIG_MTK_MT_WIFI_PATH="mt_wifi"
CONFIG_MTK_MUMIMO_SUPPORT=y
CONFIG_MTK_MU_RA_SUPPORT=y
CONFIG_MTK_OFFCHANNEL_SCAN_FEATURE=y
CONFIG_MTK_OWE_SUPPORT=y
CONFIG_MTK_PHY_ICS_SUPPORT=y
CONFIG_MTK_QOS_R1_SUPPORT=y
CONFIG_MTK_RA_PHY_RATE_SUPPORT=y
CONFIG_MTK_RED_SUPPORT=y
CONFIG_MTK_RTMP_FLASH_SUPPORT=y
CONFIG_MTK_RT_FIRST_CARD_EEPROM="flash"
CONFIG_MTK_RT_FIRST_IF_RF_OFFSET=0xc0000
CONFIG_MTK_SCS_FW_OFFLOAD=y
CONFIG_MTK_SECOND_IF_NONE=y
CONFIG_MTK_SMART_CARRIER_SENSE_SUPPORT=y
# SPECTRUM 是频谱扫描诊断，家用固件关闭
# CONFIG_MTK_SPECTRUM_SUPPORT is not set
CONFIG_MTK_SUPPORT_OPENWRT=y
CONFIG_MTK_THERMAL_PROTECT_SUPPORT=y
CONFIG_MTK_THIRD_IF_NONE=y
CONFIG_MTK_TPC_SUPPORT=y
CONFIG_MTK_TXBF_SUPPORT=y
CONFIG_MTK_UAPSD=y
CONFIG_MTK_VLAN_SUPPORT=y
CONFIG_MTK_VOW_SUPPORT=y
CONFIG_MTK_WARP_V2=y
CONFIG_MTK_WDS_SUPPORT=y
CONFIG_MTK_WHNAT_SUPPORT=m
CONFIG_MTK_WIFI_ADIE_TYPE="mt7976"
CONFIG_MTK_WIFI_BASIC_FUNC=y
CONFIG_MTK_WIFI_DRIVER=y
CONFIG_MTK_WIFI_EAP_FEATURE=y
CONFIG_MTK_WIFI_FW_BIN_LOAD=y
CONFIG_MTK_WIFI_MODE_AP=m
CONFIG_MTK_WIFI_MT_MAC=y
CONFIG_MTK_WIFI_SKU_TYPE="AX6000"
CONFIG_MTK_WIFI_TWT_SUPPORT=y
CONFIG_MTK_WLAN_HOOK=y
CONFIG_MTK_WLAN_SERVICE=y
CONFIG_MTK_WNM_SUPPORT=y
CONFIG_MTK_WPA3_SUPPORT=y
CONFIG_MTK_WSC_INCLUDED=y
CONFIG_MTK_WSC_V2_SUPPORT=y
CONFIG_WARP_CHIPSET="mt7986"
# 关掉 WARP 调试：生产固件不需要调试日志与内存泄漏检测，减少驱动体积/运行时开销
# CONFIG_WARP_DBG_SUPPORT is not set
# CONFIG_WARP_MEMORY_LEAK_DBG is not set
CONFIG_WARP_VERSION=2
CONFIG_WED_HW_RRO_SUPPORT=y
CONFIG_first_card=y
CONFIG_first_card_name="MT7986"
# CONFIG_MTK_BAND_STEERING is not set
# CONFIG_MTK_DEFAULT_5G_PROFILE is not set
# CONFIG_MTK_MAC_REPEATER_SUPPORT is not set
# CONFIG_MTK_MULTI_PROFILE_SUPPORT is not set
# CONFIG_MTK_PCIE_ASPM_DYM_CTRL_SUPPORT is not set
# CONFIG_MTK_PRE_CAL_TRX_SET1_SUPPORT is not set
# CONFIG_MTK_PRE_CAL_TRX_SET2_SUPPORT is not set
# CONFIG_MTK_RLM_CAL_CACHE_SUPPORT is not set
# CONFIG_MTK_SNIFFER_RADIOTAP_SUPPORT is not set

#######################################################################
#                            PACKAGES                                 #
#######################################################################

CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_ucode-mod-datconf=y
CONFIG_PACKAGE_l1util=y
CONFIG_PACKAGE_ucode-mod-l1parser=y
CONFIG_PACKAGE_kvcedit=y
CONFIG_PACKAGE_libkvcutil=y
CONFIG_PACKAGE_mii_mgr=y
CONFIG_PACKAGE_regs=y
CONFIG_PACKAGE_switch=y
CONFIG_PACKAGE_wifi-dats=y

CONFIG_PACKAGE_mtwifi-cfg-ucode=y
CONFIG_PACKAGE_hnat-detect=y
CONFIG_PACKAGE_mtk-smp=y

CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y

# 新增：计划重启 / 网页终端（WOL 已按需求移除）
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
# WOL 已移除：不装 luci-app-wol / luci-i18n-wol-zh-cn / etherwake

# 移除：smartdns / 网速控制 / UPnP
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn is not set
# CONFIG_PACKAGE_luci-app-eqos-mtk is not set
# CONFIG_PACKAGE_luci-i18n-eqos-mtk-zh-cn is not set
# CONFIG_PACKAGE_mtkhqos_util is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_miniupnpd is not set

CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_ca-certificates=y
# CONFIG_PACKAGE_ebtables is not set
CONFIG_PACKAGE_ethtool=y
# CONFIG_PACKAGE_htop is not set
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo-ucode=y
CONFIG_PACKAGE_libatomic=y
CONFIG_PACKAGE_libblkid=y
# CONFIG_PACKAGE_libcap-ng is not set
# CONFIG_PACKAGE_libcbor is not set
# CONFIG_PACKAGE_libevdev is not set
# CONFIG_PACKAGE_libfido2 is not set
# CONFIG_PACKAGE_libncurses is not set
CONFIG_PACKAGE_libnl=y
CONFIG_PACKAGE_libnl-core=y
CONFIG_PACKAGE_libnl-genl=y
CONFIG_PACKAGE_libnl-nf=y
CONFIG_PACKAGE_libnl-route=y
CONFIG_PACKAGE_libopenssl-afalg_sync=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
# CONFIG_PACKAGE_libpcap is not set
CONFIG_PACKAGE_libstdcpp=y
# CONFIG_PACKAGE_libudev-zero is not set
CONFIG_PACKAGE_libuuid=y
# 显式锁定网页界面：不要靠上游 defconfig 的默认值兜底
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-theme-bootstrap-mod is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_openssh-keygen is not set
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_tc-tiny=y
# CONFIG_PACKAGE_tcpdump is not set
# CONFIG_PACKAGE_terminfo is not set
CONFIG_PACKAGE_wireless-regdb=y
# CONFIG_PACKAGE_wireless-tools is not set
CONFIG_PACKAGE_zram-swap=y

#######################################################################
#                              MISC                                   #
#######################################################################

# CONFIG_AFALG_FALLBACK is not set
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
# CONFIG_PKG_FORTIFY_SOURCE_1 is not set
CONFIG_PKG_FORTIFY_SOURCE_2=y
CONFIG_PKG_RELRO_FULL=y
