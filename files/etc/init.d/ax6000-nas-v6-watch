#!/bin/sh /etc/rc.common
# 定时兜底：前缀变了却没触发接口事件（事件丢失、事件早于 NAS 完成 SLAAC、
# 或者局端静默改前缀），每 10 分钟重跑一次同步。地址没变时不做任何写操作。
#
# 用 timeout 包住：单次执行若卡在 fw4 reload / uci 锁上，本轮会被杀掉，
# 循环继续往下走，不会像原来那样整体挂死（procd 的 respawn 只管进程退出）。
USE_PROCD=1
START=99

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		sleep 20
		while true; do
			timeout 120 /usr/sbin/nas-v6-firewall
			sleep 600
		done'
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}