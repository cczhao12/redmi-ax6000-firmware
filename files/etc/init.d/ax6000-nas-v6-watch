#!/bin/sh /etc/rc.common
# 定时兜底：前缀变了却没触发接口事件（事件丢失、事件早于 NAS 完成 SLAAC、
# 或者局端静默改前缀），每 10 分钟重跑一次同步。地址没变时不做任何写操作。
#
# 本固件没有 timeout（busybox 也没编进该 applet），所以用 shell 自己实现：
# 单次执行超过 120 秒就收掉，避免卡在 fw4 reload / uci 锁上导致整个循环挂死。
USE_PROCD=1
START=99

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		sleep 20
		while true; do
			/usr/sbin/nas-v6-firewall &
			_p=$!
			( sleep 120; kill "$_p" 2>/dev/null ) &
			_w=$!
			wait "$_p"
			kill "$_w" 2>/dev/null
			sleep 580
		done'
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}