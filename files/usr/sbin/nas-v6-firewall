#!/bin/sh
# 让 IPv6 端口放行规则跟着 NAS 的地址走。
#
# 解析链：
#   NAS 的内网 IPv4（默认 192.168.6.4，可用 ax6000.nas.ip 覆盖）
#     -> 邻居表里查到它的 MAC
#     -> 按 MAC 找到它的全局 IPv6（EUI-64，后 64 位由 MAC 推导，永远不变）
#     -> 写回 firewall.nas_v6_ports.dest_ip
#
# 为什么不写死 IPv6：本线路只有 IPv6 公网，前缀由 ISP 经 PD 下发，重拨后会变。
# 为什么不写死 MAC：本仓库是公开的，MAC 属于设备标识。用内网 IP 反查即可，
#   IP 既不敏感、恢复出厂后也好记。想跳过反查也可以显式配 ax6000.nas.mac。
#
# 触发点：/etc/hotplug.d/iface/90-nas-v6（wan / wan_6 上线或地址更新时）
# 幂等：解析出的地址与规则里的一致就直接退出，不做无谓的 firewall reload。

RULE='nas_v6_ports'
IFACE='br-lan'

NAS_IP="$(uci -q get ax6000.nas.ip)"
[ -n "$NAS_IP" ] || NAS_IP='192.168.6.4'

mac_of_ip() {
	ip neigh show dev "$IFACE" 2>/dev/null |
		awk -v ip="$NAS_IP" '
			$1 == ip {
				for (i = 2; i < NF; i++)
					if ($i == "lladdr") { print $(i + 1); exit }
			}'
}

ping_allnodes() {
	if command -v ping6 >/dev/null 2>&1; then
		ping6 -c 1 -W 1 -I "$IFACE" ff02::1 >/dev/null 2>&1
	elif ping -6 -c 1 -W 1 -I "$IFACE" ff02::1 >/dev/null 2>&1; then
		:
	fi
}

resolve_v6() {
	ip -6 neigh show dev "$IFACE" 2>/dev/null |
		awk -v mac="$1" '
			BEGIN { mac = tolower(mac) }
			tolower($3) == mac && $1 ~ /:/ && $1 !~ /^fe80/ { print $1; exit }'
}

# ---- 1. 拿 MAC：显式配置优先，否则用 LAN IP 反查 ----
NAS_MAC="$(uci -q get ax6000.nas.mac)"
if [ -z "$NAS_MAC" ]; then
	NAS_MAC="$(mac_of_ip)"
	if [ -z "$NAS_MAC" ]; then
		# 邻居表里没有就先 ping 一下，把它填进去
		ping -c 1 -W 1 "$NAS_IP" >/dev/null 2>&1
		NAS_MAC="$(mac_of_ip)"
	fi
fi

if [ -z "$NAS_MAC" ]; then
	logger -t nas-v6-fw "无法从 $NAS_IP 解析 MAC（设备离线？），保持规则不动"
	exit 0
fi

# ---- 2. 按 MAC 找全局 IPv6 ----
ADDR=
i=0
while [ "$i" -lt 3 ]; do
	ADDR="$(resolve_v6 "$NAS_MAC")"
	[ -n "$ADDR" ] && break
	ping_allnodes
	sleep 1
	i=$((i + 1))
done

if [ -z "$ADDR" ]; then
	logger -t nas-v6-fw "$NAS_MAC 没有全局 IPv6，保持规则不动"
	exit 0
fi

# ---- 3. 写回规则 ----
if [ -z "$(uci -q get "firewall.$RULE")" ]; then
	logger -t nas-v6-fw "规则 $RULE 不存在，跳过（先用 LuCI 建好这条放行规则）"
	exit 0
fi

CUR="$(uci -q get "firewall.$RULE.dest_ip")"
[ "$CUR" = "$ADDR" ] && exit 0

uci -q set "firewall.$RULE.dest_ip=$ADDR"
uci -q commit firewall
fw4 reload >/dev/null 2>&1
logger -t nas-v6-fw "dest_ip ${CUR:-none} -> $ADDR"
exit 0
