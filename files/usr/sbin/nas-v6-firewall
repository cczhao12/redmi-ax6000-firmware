#!/bin/sh
# 让 IPv6 端口放行规则跟着 NAS 的地址走。
#
# 解析链：
#   NAS 内网 IPv4（默认 192.168.6.4，可 ax6000.nas.ip 覆盖）
#     -> 邻居表查出 MAC
#     -> 按 MAC 找到它的全局 IPv6
#
# 关键：邻居表会长期保留 STALE 条目。前缀更换后，旧前缀的地址仍可能排在前面，
# 直接"取第一个"会把规则钉到死地址上，而且因为写入成功就再也不会自纠。
# 所以候选地址必须同时满足两条：
#   (1) 它的 /64 属于 br-lan 当前持有的公网前缀；
#   (2) 真的 ping 得通。
# 两条都不过时，用「当前前缀 + 由 MAC 推导的 EUI-64 后缀」直接算出来再 ping。
#
# 触发：/etc/hotplug.d/iface/90-nas-v6（wan / wan_6 上线或地址更新）
#       + /etc/init.d/ax6000-nas-v6-watch（每 10 分钟兜底，防漏事件）
# 幂等：解析结果与规则一致就直接退出。

RULE='nas_v6_ports'
IFACE='br-lan'

NAS_IP="$(uci -q get ax6000.nas.ip)"
[ -n "$NAS_IP" ] || NAS_IP='192.168.6.4'

log() { logger -t nas-v6-fw "$*"; }

# br-lan 当前持有的公网 /64 前缀（跳过 ULA fc00::/7 与链路本地）
lan_prefixes() {
	ip -6 addr show dev "$IFACE" scope global 2>/dev/null |
		awk '
			$1 == "inet6" {
				split($2, a, "/");
				split(a[1], g, ":");
				p = tolower(substr(g[1], 1, 2));
				if (p == "fc" || p == "fd") next;
				print g[1] ":" g[2] ":" g[3] ":" g[4];
			}' | sort -u
}

prefix_of() {
	echo "$1" | cut -d: -f1-4
}

ping_ok() {
	ping6 -c 1 -W 1 "$1" >/dev/null 2>&1
}

# 由 MAC 推出 EUI-64 后缀：52:54:00:12:34:56 -> 5054:00ff:fe12:3456
eui64_suffix() {
	IFS=':' read -r m1 m2 m3 m4 m5 m6 <<EOF
$1
EOF
	printf '%02x%02x:%02xff:fe%02x:%02x%02x' \
		$((0x$m1 ^ 2)) $((0x$m2)) $((0x$m3)) \
		$((0x$m4)) $((0x$m5)) $((0x$m6))
}

mac_of_ip() {
	ip neigh show dev "$IFACE" 2>/dev/null |
		awk -v ip="$NAS_IP" '
			$1 == ip {
				for (i = 2; i < NF; i++)
					if ($i == "lladdr") { print $(i + 1); exit }
			}'
}

# ---- 1. MAC ----
NAS_MAC="$(uci -q get ax6000.nas.mac)"
if [ -z "$NAS_MAC" ]; then
	NAS_MAC="$(mac_of_ip)"
	[ -n "$NAS_MAC" ] || { ping -c 1 -W 1 "$NAS_IP" >/dev/null 2>&1; NAS_MAC="$(mac_of_ip)"; }
fi
if [ -z "$NAS_MAC" ]; then
	log "无法从 $NAS_IP 解析 MAC（设备离线？），保持规则不动"
	exit 0
fi

PREFIXES="$(lan_prefixes)"
[ -n "$PREFIXES" ] || { log "br-lan 没有公网 IPv6 前缀，保持规则不动"; exit 0; }

# ---- 2. 候选地址 ----
CANDIDATES="$(ip -6 neigh show dev "$IFACE" 2>/dev/null |
	awk -v mac="$NAS_MAC" '
		BEGIN { mac = tolower(mac) }
		tolower($3) == mac && $1 ~ /:/ && $1 !~ /^fe80/ { print $1 }')"

ADDR=
for cand in $CANDIDATES; do
	p="$(prefix_of "$cand")"
	echo "$PREFIXES" | grep -qx "$p" || continue
	# 旧前缀的地址可能还挂在邻居表里，但已经不通了
	ping_ok "$cand" || continue
	ADDR="$cand"
	break
done

# ---- 3. 兜底：前缀 + EUI-64 直接算 ----
if [ -z "$ADDR" ]; then
	SUF="$(eui64_suffix "$NAS_MAC")"
	for p in $PREFIXES; do
		cand="$p:$SUF"
		ping_ok "$cand" || continue
		ADDR="$cand"
		break
	done
fi

if [ -z "$ADDR" ]; then
	log "$NAS_MAC 没有可用的全局 IPv6（前缀未生效或 NAS 未完成 SLAAC），保持规则不动"
	exit 0
fi

# ---- 4. 写回 ----
if [ -z "$(uci -q get "firewall.$RULE")" ]; then
	log "规则 $RULE 不存在，跳过（先用 LuCI 建好这条放行规则）"
	exit 0
fi

CUR="$(uci -q get "firewall.$RULE.dest_ip")"
[ "$CUR" = "$ADDR" ] && exit 0

uci -q set "firewall.$RULE.dest_ip=$ADDR"
uci -q commit firewall
fw4 reload >/dev/null 2>&1
log "dest_ip ${CUR:-none} -> $ADDR"
exit 0
